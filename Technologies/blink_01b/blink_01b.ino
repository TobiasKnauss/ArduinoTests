void setup()
{
  pinMode (LED_BUILTIN, OUTPUT);
}

void loop()
{
  digitalWrite (LED_BUILTIN, ON);
  digitalWrite (LED_BUILTIN, OFF);
  digitalWrite (LED_BUILTIN, ON);
  digitalWrite (LED_BUILTIN, OFF);
  digitalWrite (LED_BUILTIN, ON);
  digitalWrite (LED_BUILTIN, OFF);
  digitalWrite (LED_BUILTIN, ON);
  digitalWrite (LED_BUILTIN, OFF);
  digitalWrite (LED_BUILTIN, ON);
  digitalWrite (LED_BUILTIN, OFF);
}
